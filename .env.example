DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DATABASE_SSL=true
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
ACCESS_TOKEN_SECRET="replace-with-at-least-32-random-characters"
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_DAYS=30
# Use "none" when frontend and API are on different sites/domains in production.
# "none" requires HTTPS and is sent only when secure cookies are enabled.
REFRESH_COOKIE_SAMESITE=lax
# Production signup OTP delivery (Resend HTTP API)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
OTP_FROM_EMAIL="ApexLab <no-reply@yourdomain.com>"
