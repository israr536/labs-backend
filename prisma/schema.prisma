generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TECHNICIAN
  RECEPTIONIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ReportStatus {
  DRAFT
  FINAL
}

enum ResultFlag {
  LOW
  NORMAL
  HIGH
}

enum ParameterInputType {
  NUMBER
  TEXT
  SELECT
}

model Lab {
  id                  String    @id @default(uuid())
  code                String    @unique
  name                String
  mobile              String
  email               String?
  address             String?
  icon                String?
  isActive            Boolean   @default(true)
  subscriptionPlan    String?
  subscriptionStartAt DateTime?
  subscriptionEndAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  patients Patient[]
  reports  Report[]
  tests    Test[]
  users    User[]
}

model User {
  id        String   @id @default(uuid())
  labId     String
  username  String   @unique
  mobile    String
  email     String?
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lab           Lab            @relation(fields: [labId], references: [id])
  createdReports Report[]      @relation("ReportCreatedBy")
  refreshTokens RefreshToken[]

  @@index([labId])
}

model Patient {
  id          String    @id @default(uuid())
  labId       String
  name        String
  dateOfBirth DateTime?
  age         Int?
  gender      Gender
  mobile      String?
  email       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lab     Lab      @relation(fields: [labId], references: [id])
  reports Report[]

  @@index([labId])
}

model Test {
  id          String   @id @default(uuid())
  labId       String

  code        String
  shortName   String?

  name        String

  category    String?
  department  String?

  sampleType  String?

  price       Float?

  tat         Int?

  method      String?

  remarks     String?

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lab         Lab             @relation(fields: [labId], references: [id])
  parameters  TestParameter[]
  reports     Report[]

  @@index([labId])
  @@index([category])
  @@index([department])
  @@unique([labId, code])
}

model TestParameter {
  id               String             @id @default(uuid())
  testId           String

  name             String

  inputType        ParameterInputType @default(NUMBER)

  unit             String?

  normalMin        Float?
  normalMax        Float?

  referenceRange   Json?

  options          Json?

  displayOrder     Int                @default(0)

  isRequired       Boolean            @default(true)

  remarks          String?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  test             Test               @relation(fields: [testId], references: [id], onDelete: Cascade)
  results          ReportResult[]

  @@index([testId])
  @@unique([testId, name])
}

model Report {
  id          String       @id @default(uuid())
  labId       String
  patientId   String
  testId      String
  reportNumber String     @unique
  createdById String
  status      ReportStatus @default(DRAFT)
  remarks     String?
  doctorNotes String?
  referredBy  String?
  approvedBy  String?
  sampleCollectedAt DateTime?
  reportedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy User           @relation("ReportCreatedBy", fields: [createdById], references: [id])
  lab       Lab            @relation(fields: [labId], references: [id])
  patient   Patient        @relation(fields: [patientId], references: [id])
  results   ReportResult[]
  test      Test           @relation(fields: [testId], references: [id])

  @@index([labId])
  @@index([patientId])
  @@index([testId])
}

model ReportResult {
  id          String      @id @default(uuid())
  reportId    String
  parameterId String
  value       String
  flag        ResultFlag?
  createdAt   DateTime    @default(now())

  parameter TestParameter @relation(fields: [parameterId], references: [id])
  report    Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, parameterId])
  @@index([parameterId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model PendingLabRegistration {
  id                String   @id @default(uuid())
  code              String
  name              String
  mobile            String
  email             String?
  address           String?
  adminUsername     String
  adminMobile       String
  adminEmail        String?
  adminPasswordHash String
  otpHash           String
  attempts          Int      @default(0)
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([code])
  @@index([adminUsername])
  @@index([expiresAt])
}
